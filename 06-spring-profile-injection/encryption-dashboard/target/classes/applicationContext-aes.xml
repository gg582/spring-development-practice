<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    profile="aes"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.3.xsd">

    <bean id="encryptManager" class="com.example.app.crypto.algorithms.AESEncryptManager" />
    <bean id="decryptManager" class="com.example.app.crypto.algorithms.AESDecryptManager" />

    <bean id="fileEncryptorFactory" class="com.example.app.crypto.factory.FileEncryptorFactory">
        <property name="encryptManager" ref="encryptManager" />
    </bean>
    <bean id="fileDecryptorFactory" class="com.example.app.crypto.factory.FileDecryptorFactory">
        <property name="decryptManager" ref="decryptManager" />
    </bean>
</beans>