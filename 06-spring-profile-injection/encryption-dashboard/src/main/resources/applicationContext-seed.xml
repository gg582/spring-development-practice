<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    profile="seed"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.3.xsd">

    <!-- SEED 암호화/복호화 매니저 빈 정의 -->
    <!--
        실제 운영 환경에서는 기본 키와 IV를 사용하지 않고,
        외부 설정 파일이나 보안 저장소에서 가져오거나 동적으로 생성해야 합니다.
        여기서는 예시를 위해 기본값을 사용하거나, Bean 설정에서 주입받는 것을 가정합니다.
        SecretKey 객체는 Bean 설정에서 SecretKeySpec 등으로 생성하여 주입받도록 합니다.
    -->
    <bean id="seedEncryptManager" class="com.example.app.crypto.algorithms.SEEDEncryptManager">
    </bean>
    <bean id="seedDecryptManager" class="com.example.app.crypto.algorithms.SEEDDecryptManager">
    </bean>
    <bean id="seedSecretKey" class="javax.crypto.spec.SecretKeySpec">
        <!-- Base64 또는 다른 안전한 방식으로 키를 저장하고 로드해야 합니다. -->
        <!-- 예시: 16바이트 키 (0x01 ~ 0x10) -->
        <constructor-arg>
            <array value-type="byte">
                <value>1</value>
                <value>2</value>
                <value>3</value>
                <value>4</value>
                <value>5</value>
                <value>6</value>
                <value>7</value>
                <value>8</value>
                <value>9</value>
                <value>10</value>
                <value>11</value>
                <value>12</value>
                <value>13</value>
                <value>14</value>
                <value>15</value>
                <value>16</value>
            </array>
        </constructor-arg>
        <constructor-arg name="algorithm" value="SEED"/>
    </bean>
    <!--
        CBC 모드에서는 각 암호화/복호화 작업마다 고유한 IV를 사용하는 것이 권장됩니다.
        여기서는 고정된 IV를 사용하며, 실제 환경에서는 동적으로 생성하거나 안전하게 관리해야 합니다.
    -->
    <bean id="seedIV" class="java.util.Arrays" factory-method="copyOf">
        <!-- 예시: 16바이트 IV -->
        <constructor-arg>
            <array value-type="byte">
                <value>2</value>
                <value>3</value>
                <value>4</value>
                <value>5</value>
                <value>6</value>
                <value>7</value>
                <value>8</value>
                <value>9</value>
                <value>10</value>
                <value>11</value>
                <value>12</value>
                <value>13</value>
                <value>14</value>
                <value>15</value>
                <value>16</value>
                <value>17</value>
            </array>
        </constructor-arg>
        <constructor-arg value="16"/>
    </bean>

    <bean id="fileEncryptorFactory" class="com.example.app.crypto.factory.FileEncryptorFactory">
        <!--
            seedEncryptManager Bean을 참조하여 encryptManager 프로퍼티에 설정합니다.
            Spring Profile 'seed'가 활성화되면 이 Manager가 주입됩니다.
        -->
        <property name="encryptManager" ref="seedEncryptManager"/>
    </bean>
    <bean id="fileDecryptorFactory" class="com.example.app.crypto.factory.FileDecryptorFactory">
        <!--
            seedDecryptManager Bean을 참조하여 decryptManager 프로퍼티에 설정합니다.
            Spring Profile 'seed'가 활성화되면 이 Manager가 주입됩니다.
        -->
        <property name="decryptManager" ref="seedDecryptManager"/>
    </bean>
</beans>
