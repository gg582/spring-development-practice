<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mapper.MusicianMapper">

    <select id="selectAllMusicians" resultType="com.example.model.MusicianVO">
        SELECT 
            id, 
            name, 
            genre 
        FROM 
            musicians
    </select>

  <insert id="insert">
    INSERT INTO musicians (name, genre)
    VALUES (#{name}, #{genre})
  </insert>

	<update id="update">
		UPDATE musicians
		SET name = #{name},
				genre = #{genre}
		WHERE id = #{id}
	</update>

  <delete id="deleteById">
  DELETE FROM musicians WHERE id = #{id}
  </delete>

  <delete id="deleteByName">
    DELETE FROM musicians WHERE name = #{name}
  </delete>

</mapper>
